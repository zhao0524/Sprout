# Supabase project URL (safe in the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (public; identifies the project, does not bypass RLS).
# If your project only offers the legacy format, use the anon key value here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# n8n webhook base URL — event-driven flows POST JSON here (e.g. /sprout/weather).
# The frontend reads results directly from Supabase; there is no custom API server.
VITE_N8N_WEBHOOK_BASE_URL=https://davidzhao0524.app.n8n.cloud/webhook/
