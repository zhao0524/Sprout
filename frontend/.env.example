# Supabase project URL (safe in the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (public; identifies the project, does not bypass RLS).
# If your project only offers the legacy format, use the anon key value here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# FastAPI backend base URL (optimizer, estimates, weather, marketplace, 3D generation).
# Defaults to http://localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000
